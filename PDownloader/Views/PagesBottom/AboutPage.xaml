<Page x:Class="PDownloader.Views.PagesBottom.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="clr-namespace:PDownloader.Helpers"
      xmlns:controls="clr-namespace:PDownloader.Controls"
      xmlns:local="clr-namespace:PDownloader.Views.PagesBottom"
      xmlns:utils="clr-namespace:PDownloader.Utils"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="AboutPage"
      d:DataContext="{d:DesignInstance local:AboutPage,
                                     IsDesignTimeCreatable=False}"
      d:DesignHeight="450"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <Grid Margin="0 0 0 30">
        <StackPanel HorizontalAlignment="Stretch">

            <!-- App Identity -->
            <ui:CardAction Margin="0,0,0,8"
                           IsChevronVisible="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:Image Grid.Column="0"
                              Source="pack://application:,,,/Assets/app-256.png"
                              Width="50"
                              Height="50" />
                    <StackPanel  Grid.Column="2"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Center">
                        <ui:TextBlock Text="{utils:Localization app_capitalized_name_title}"
                                   FontSize="15"
                                   FontWeight="Bold" />
                        <ui:TextBlock Text="{utils:Localization app_description_summary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </ui:CardAction>

            <!-- Info card -->
            <ui:CardAction Margin="0,0,0,8"
                     IsChevronVisible="False">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="Apps24"
                                       FontSize="15"
                                       Margin="0 0 8 0" />
                        <TextBlock Text="{utils:Localization about_app_title}"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                    </StackPanel>
                    
                    <controls:InfoRow LabelText="{utils:Localization version_title}"
                                      ValueText="{Binding ViewModel.AppVersion}"
                                      NavigateUri="https://github.com/maihcx/PDownloader/releases"/>
                    <controls:InfoRow LabelText="{utils:Localization framework_title}"
                                      ValueText=".NET 10 / WPF" />
                    <controls:InfoRow LabelText="{utils:Localization ui_lib_title}"
                                      ValueText="WPF-UI v4.3.0 by lepoco" />
                    <controls:InfoRow LabelText="{utils:Localization dep_lib_title}">
                        <controls:InfoRow.ValueContent>
                            <StackPanel Orientation="Horizontal">
                                <ui:HyperlinkButton NavigateUri="https://github.com/yt-dlp/yt-dlp">
                                    <ui:TextBlock Text="yt-dlp"
                                                  FontSize="12"
                                                  FontWeight="Medium"
                                                  VerticalAlignment="Center"
                                                  TextTrimming="CharacterEllipsis" />
                                </ui:HyperlinkButton>

                                <ui:HyperlinkButton NavigateUri="https://github.com/ffmpeg/ffmpeg">
                                    <ui:TextBlock Text="FFmpeg"
                                                  FontSize="12"
                                                  FontWeight="Medium"
                                                  VerticalAlignment="Center"
                                                  TextTrimming="CharacterEllipsis" />
                                </ui:HyperlinkButton>
                            </StackPanel>
                        </controls:InfoRow.ValueContent>
                    </controls:InfoRow>
                    <controls:InfoRow LabelText="{utils:Localization license_title}"
                                      ValueText="GPL-3.0"
                                      NavigateUri="https://github.com/maihcx/PDownloader/blob/main/LICENSE"
                                      IsLast="True" />
                </StackPanel>
            </ui:CardAction>

            <ui:CardAction Margin="0 0 0 8"
                           IsChevronVisible="False">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0 0 0 12">
                        <ui:SymbolIcon Symbol="BuildingFactory24"
                                       FontSize="15"
                                       Margin="0 0 8 0" />
                        <TextBlock Text="{utils:Localization about_us_title}"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                    </StackPanel>
                    
                    <ui:CardExpander ContentPadding="0"
                                     Icon="{ui:ImageIcon 'pack://application:,,,/Assets/app-100.png', Width=38, Height=38}"
                                     Margin="0 0 0 8">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Grid.Row="0"
                                              Grid.Column="0"
                                              FontTypography="Body"
                                              Text="PDownloader"
                                              TextWrapping="Wrap" />
                                <ui:TextBlock Grid.Row="1"
                                              Grid.Column="0"
                                              Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                              Text="{Binding ViewModel.CopyRight, Mode=OneWay}"
                                              TextWrapping="Wrap" />
                                <TextBlock Grid.Row="0"
                                           Grid.RowSpan="2"
                                           Grid.Column="1"
                                           Margin="0,0,16,0"
                                           VerticalAlignment="Center"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{Binding ViewModel.AppVersion, Mode=OneWay}" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <ui:Anchor Margin="0"
                                       Padding="16"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Stretch"
                                       Background="Transparent"
                                       BorderThickness="0,1,0,0"
                                       CornerRadius="0"
                                       NavigateUri="https://www.facebook.com/MaiXuan.HuynhOR/">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{utils:Localization contact_us_title}" />
                                    <ui:SymbolIcon Grid.Column="1"
                                                   Symbol="Link24" />
                                </Grid>
                            </ui:Anchor>
                            <ui:TextBlock Margin="16 8 0 16">
                                <Run Text="{utils:Localization version_title}" /><Run Text=":" />
                                <Run Text="{Binding ViewModel.AppVersion, Mode=OneWay}" />
                            </ui:TextBlock>
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:InfoBar Margin="0,0,0,8"
                                Message="{utils:Localization open_source_summary}"
                                Severity="Informational"
                                IsOpen="True"
                                IsClosable="False" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:InfoBar Grid.Column="0"
                                    Message="{utils:Localization issue_report_summary}"
                                    Severity="Warning"
                                    IsOpen="True"
                                    IsClosable="False"
                                    HorizontalAlignment="Stretch" />

                        <ui:HyperlinkButton VerticalAlignment="Stretch"
                                            Grid.Column="2"
                                            NavigateUri="https://github.com/maihcx/PDownloader/issues/new/choose">
                            <ui:HyperlinkButton.Resources>
                                <Style TargetType="ui:HyperlinkButton"
                                       BasedOn="{StaticResource {x:Type ui:Button}}" />
                            </ui:HyperlinkButton.Resources>

                            <TextBlock Text="{utils:Localization report_issue_title}" />
                        </ui:HyperlinkButton>
                    </Grid>
                </StackPanel>
            </ui:CardAction>
        </StackPanel>
    </Grid>
</Page>
