<Page x:Class="PDownloader.Views.Pages.ConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PDownloader.Views.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:utils="clr-namespace:PDownloader.Utils"
      Title="ConfigPage"
      d:DataContext="{d:DesignInstance local:ConfigPage, IsDesignTimeCreatable=False}"
      d:DesignHeight="450"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d"
      ScrollViewer.CanContentScroll="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="1"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" />

        <ScrollViewer ui:SmoothScrollBehavior.IsEnabled="True"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,8">
            <StackPanel>

                <!-- Download folder -->
                <ui:CardExpander Icon="{ui:SymbolIcon Folder24}"
                                 Margin="0,0,0,8"
                                 IsExpanded="False">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body"
                                          Text="{utils:Localization page_config_folder_title}"
                                          FontWeight="SemiBold"
                                          TextWrapping="Wrap" />
                            <TextBlock Text="{utils:Localization page_config_folder_summary}"
                                       Opacity="0.6"
                                       FontSize="12" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding ViewModel.DownloadConfigs.DefaultDownloadFolder, Mode=TwoWay}"
                                    PlaceholderText="{utils:Localization page_config_folder_placeholder}" />
                        <ui:Button Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Content="{utils:Localization page_config_folder_browse}"
                                   Command="{Binding ViewModel.BrowseDownloadFolderCommand}" />
                    </Grid>
                </ui:CardExpander>

                <!-- Temporary download data folder -->
                <ui:CardExpander Icon="{ui:SymbolIcon FolderOpen24}"
                                 Margin="0,0,0,8"
                                 IsExpanded="False">
                    <ui:CardExpander.Header>
                        <StackPanel Margin="0 0 4 0">
                            <ui:TextBlock FontTypography="Body"
                                          Text="{utils:Localization page_config_temp_folder_title}"
                                          FontWeight="SemiBold"
                                          TextWrapping="Wrap" />
                            <TextBlock Text="{utils:Localization page_config_temp_folder_summary}"
                                       Opacity="0.6"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding ViewModel.DownloadConfigs.DefaultTempFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{utils:Localization page_config_temp_folder_placeholder}" />
                        <ui:Button Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Content="{utils:Localization page_config_temp_folder_default}"
                                   Command="{Binding ViewModel.ResetTempFolderCommand}" />
                        <ui:Button Grid.Column="2"
                                   Margin="8,0,0,0"
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Content="{utils:Localization page_config_folder_browse}"
                                   Command="{Binding ViewModel.BrowseTempFolderCommand}" />
                    </Grid>
                </ui:CardExpander>

                <!-- Thread count -->
                <ui:CardExpander Icon="{ui:SymbolIcon Symbol=Settings20}"
                                 Margin="0,0,0,8"
                                 IsExpanded="False">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body"
                                          Text="{utils:Localization page_config_threads_title}"
                                          FontWeight="SemiBold"
                                          TextWrapping="Wrap" />
                            <TextBlock Text="{utils:Localization page_config_threads_summary}"
                                       Opacity="0.6"
                                       FontSize="12" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel Orientation="Horizontal">
                        <Slider Minimum="1"
                                Maximum="32"
                                Value="{Binding ViewModel.DownloadConfigs.DefaultThreadCount, Mode=TwoWay}"
                                Width="240"
                                VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ViewModel.DownloadConfigs.DefaultThreadCount, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,6,0"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{utils:Localization page_config_threads_unit}"
                                   VerticalAlignment="Center"
                                   Opacity="0.6"
                                   FontSize="12" />
                    </StackPanel>
                </ui:CardExpander>

                <!-- File merge mode -->
                <ui:CardExpander Icon="{ui:SymbolIcon Symbol=Settings20}"
                                 Margin="0,0,0,8"
                                 IsExpanded="False">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body"
                                          Text="{utils:Localization page_config_merge_mode_title}"
                                          FontWeight="SemiBold"
                                          TextWrapping="Wrap" />
                            <TextBlock Text="{utils:Localization page_config_merge_mode_summary}"
                                       Opacity="0.6"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardExpander.Header>

                    <ComboBox ItemsSource="{Binding ViewModel.FileMergeModeOptions}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding ViewModel.DownloadConfigs.FileMergeMode,
                                  Mode=TwoWay,
                                  UpdateSourceTrigger=PropertyChanged}"
                              HorizontalContentAlignment="Stretch"
                              MinWidth="320"
                              MaxDropDownHeight="360"
                              IsTextSearchEnabled="False">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel MaxWidth="560"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Text="{Binding Description}"
                                               Margin="22,4,8,0"
                                               FontSize="12"
                                               Opacity="0.65"
                                               TextWrapping="Wrap">

                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}}}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ComboBoxItem}"
                                   BasedOn="{StaticResource {x:Type ComboBoxItem}}">

                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch" />

                                <Setter Property="VerticalContentAlignment"
                                        Value="Center" />

                                <Setter Property="Padding"
                                        Value="20,10" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </ui:CardExpander>

                <!-- Download progress window behavior -->
                <ui:CardExpander Icon="{ui:SymbolIcon WindowSettings20}"
                                 Margin="0,0,0,8"
                                 IsExpanded="False">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body"
                                          Text="{utils:Localization page_config_progress_window_title}"
                                          FontWeight="SemiBold"
                                          TextWrapping="Wrap" />
                            <TextBlock Text="{utils:Localization page_config_progress_window_summary}"
                                       Opacity="0.6"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardExpander.Header>

                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,16,0">
                                <TextBlock Text="{utils:Localization page_config_progress_window_close_completed_title}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{utils:Localization page_config_progress_window_close_completed_summary}"
                                           Opacity="0.6"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding ViewModel.DownloadConfigs.CloseProgressWindowWhenDownloadCompletes, Mode=TwoWay}" />
                        </Grid>

                        <Separator Opacity="0.16"
                                   Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,16,0">
                                <TextBlock Text="{utils:Localization page_config_progress_window_close_open_file_title}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{utils:Localization page_config_progress_window_close_open_file_summary}"
                                           Opacity="0.6"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding ViewModel.DownloadConfigs.CloseProgressWindowAfterOpeningFile, Mode=TwoWay}" />
                        </Grid>

                        <Separator Opacity="0.16"
                                   Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,16,0">
                                <TextBlock Text="{utils:Localization page_config_progress_window_close_open_folder_title}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{utils:Localization page_config_progress_window_close_open_folder_summary}"
                                           Opacity="0.6"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding ViewModel.DownloadConfigs.CloseProgressWindowAfterOpeningFolder, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Concurrent downloads -->
                <!--<ui:CardExpander Icon="{ui:SymbolIcon DocumentMultiple24}"
                                 Margin="0,0,0,8" IsExpanded="True">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body"
                                         Text="{utils:Localization page_config_concurrent_title}"
                                         FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{utils:Localization page_config_concurrent_summary}"
                                       Opacity="0.6" FontSize="12"/>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel Orientation="Horizontal">
                        <Slider Minimum="1" Maximum="10"
                                Value="{Binding ViewModel.MaxConcurrentDownloads}"
                                Width="200" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ViewModel.MaxConcurrentDownloads}"
                                   VerticalAlignment="Center" Margin="12,0,6,0"
                                   FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{utils:Localization page_config_concurrent_unit}"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="12"/>
                    </StackPanel>
                </ui:CardExpander>-->

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Padding="24,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding ViewModel.StatusMessage}"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           FontSize="12" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <ui:Button Content="{utils:Localization page_config_save}"
                               Icon="{ui:SymbolIcon Save24}"
                               Appearance="Primary"
                               Command="{Binding ViewModel.SaveSettingsCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
