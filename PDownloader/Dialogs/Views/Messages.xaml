<ui:ContentDialog x:Class="PDownloader.Dialogs.Views.Messages"
                  x:Name="Root"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:PDownloader.Dialogs.Views"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:utils="clr-namespace:PDownloader.Utils"
                  xmlns:controls="clr-namespace:PDownloader.Controls"
                  d:DataContext="{d:DesignInstance local:Messages,
                               IsDesignTimeCreatable=False}"
                  d:DesignHeight="450"
                  d:DesignWidth="800"
                  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  CloseButtonAppearance="{Binding ViewModel.CloseButtonAppearance, Mode=OneWay}"
                  CloseButtonText="{Binding ViewModel.CloseButtonText, Mode=OneWay}"
                  IsPrimaryButtonEnabled="{Binding ViewModel.PrimaryButtonEnabled, Mode=OneWay}"
                  PrimaryButtonAppearance="{Binding ViewModel.PrimaryButtonAppearance, Mode=OneWay}"
                  PrimaryButtonText="{Binding ViewModel.PrimaryButtonText, Mode=OneWay}"
                  IsSecondaryButtonEnabled="{Binding ViewModel.SecondaryButtonEnabled, Mode=OneWay}"
                  SecondaryButtonAppearance="{Binding ViewModel.SecondaryButtonAppearance, Mode=OneWay}"
                  SecondaryButtonText="{Binding ViewModel.SecondaryButtonText, Mode=OneWay}"
                  Title="{Binding ViewModel.Model.MessageTitle, ElementName=Root, Mode=OneWay}"
                  MaxWidth="550"
                  IsFooterVisible="True"
                  mc:Ignorable="d">

    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
               TargetType="{x:Type local:Messages}" />
    </ui:ContentDialog.Resources>

    <StackPanel Margin="16"
                Grid.IsSharedSizeScope="True"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch">
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:SymbolIcon Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="0,0,20,0"
                           FontSize="40"
                           Visibility="{Binding ViewModel.ImageVisible, Converter={StaticResource BoolToVisConverter}}"
                           Symbol="{Binding ViewModel.ImageView, Mode=OneWay}" />
            
            <TextBlock Grid.Column="1"
                       Text="{Binding ViewModel.Model.MessageContent, Mode=OneWay}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="0,0,0,0"
                       TextWrapping="Wrap" />
        </Grid>
    </StackPanel>
</ui:ContentDialog>