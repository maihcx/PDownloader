<Window x:Class="PDownloader.BugTracker.CrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PDownloader — Bug Tracker"
        Height="620"
        Width="900"
        MinHeight="480"
        MinWidth="680"
        Background="Transparent"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Action button -->
        <Style x:Key="ActionButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#1E293B" />
            <Setter Property="Foreground"
                    Value="#CBD5E1" />
            <Setter Property="BorderBrush"
                    Value="#334155" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="14,6" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#334155" />
                                <Setter Property="BorderBrush"
                                        Value="#475569" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button -->
        <Style x:Key="DangerButton"
               TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background"
                    Value="#3B1010" />
            <Setter Property="BorderBrush"
                    Value="#7F1D1D" />
            <Setter Property="Foreground"
                    Value="#FCA5A5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#7F1D1D" />
                    <Setter Property="BorderBrush"
                            Value="#EF4444" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Close button -->
        <Style x:Key="CloseButton"
               TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background"
                    Value="#1E3A5F" />
            <Setter Property="BorderBrush"
                    Value="#2563EB" />
            <Setter Property="Foreground"
                    Value="#93C5FD" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#1D4ED8" />
                    <Setter Property="BorderBrush"
                            Value="#3B82F6" />
                    <Setter Property="Foreground"
                            Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ScrollBar -->
        <!--<Style TargetType="ScrollBar">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Width"
                    Value="6" />
        </Style>-->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Meta pill bar -->
            <RowDefinition Height="Auto" />
            <!-- Log path bar -->
            <RowDefinition Height="*" />
            <!-- Log viewer -->
            <RowDefinition Height="Auto" />
            <!-- Footer toolbar -->
        </Grid.RowDefinitions>

        <!-- ── Meta pill bar ────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="#B20B1627"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="MetaPanel"
                           Orientation="Horizontal" />
            </ScrollViewer>
        </Border>

        <!-- ── Log path bar ──────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="#B20D1B2A"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📄"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <TextBlock Text="File: "
                           FontSize="11"
                           Foreground="#475569"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="LogPathText"
                           FontSize="11"
                           Foreground="#60A5FA"
                           FontFamily="Consolas"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- ── Log viewer ────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Background="#CC0B1120"
                      Padding="16,12">
            <TextBlock x:Name="LogBlock"
                       FontFamily="Consolas, Courier New"
                       FontSize="12"
                       TextWrapping="NoWrap"
                       LineHeight="20" />
        </ScrollViewer>

        <!-- ── Footer toolbar ────────────────────────────────────── -->
        <Border Grid.Row="3"
                Background="#B20F1F35"
                BorderBrush="#1E293B"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <Button x:Name="OpenFolderBtn"
                            Content="📁  Open Folder"
                            Style="{StaticResource ActionButton}"
                            Margin="0,0,8,0"
                            Click="OpenFolder_Click" />
                    <Button x:Name="CopyBtn"
                            Content="📋  Copy Log"
                            Style="{StaticResource ActionButton}"
                            Margin="0,0,8,0"
                            Click="Copy_Click" />
                    <Button x:Name="DeleteBtn"
                            Content="🗑  Delete Log"
                            Style="{StaticResource DangerButton}"
                            Click="Delete_Click" />
                    <Button x:Name="ReportBtn"
                            Content="🐛  Report"
                            Style="{StaticResource ActionButton}"
                            Margin="8,0,0,0"
                            Click="Report_Click" />
                </StackPanel>

                <Button Content="Close"
                        Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Width="80"
                        Click="CloseWindow_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>