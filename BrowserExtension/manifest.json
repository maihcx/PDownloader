{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.6",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "downloads",
    "storage",
    "cookies",
    "activeTab",
    "contextMenus",
    "webRequest",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["common/i18n.js", "content/content.js"],
      "all_frames": true,
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.youtube.com/watch*", "*://*.youtube.com/shorts/*"],
      "js": ["common/i18n.js", "content/youtube_content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["common/theme.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
