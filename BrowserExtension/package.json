{
  "name": "pdownloader-browser-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check-extension.mjs",
    "dev": "vite build --mode chromium --watch",
    "prebuild:chrome": "pnpm run check",
    "build:chrome": "node scripts/build-chrome.mjs",
    "prebuild:firefox": "pnpm run check",
    "build:firefox": "node scripts/build-firefox.mjs",
    "prebuild:firefox-nosign": "pnpm run check",
    "build:firefox-nosign": "node scripts/build-firefox-nosign.mjs",
    "build": "pnpm run build:chrome && pnpm run build:firefox"
  },
  "devDependencies": {
    "adm-zip": "^0.6.0",
    "vite": "^8.2.1",
    "vite-plugin-static-copy": "^4.1.1",
    "web-ext": "^8.10.0"
  }
}
