<UserControl
    x:Class="PDownloader.Installer.Views.Pages.UninstallConfirmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PDownloader.Installer.Utils"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="40,32">
        <StackPanel VerticalAlignment="Center">
            <ui:SymbolIcon Margin="0,0,0,20"
                           FontSize="56"
                           Foreground="OrangeRed"
                           Symbol="Delete48" />
            <TextBlock Margin="0,0,0,12"
                       HorizontalAlignment="Center"
                       FontSize="24"
                       FontWeight="Bold"
                       Text="{local:LocalizationExtension uninstall_title}" />
            <TextBlock Margin="0,0,0,32"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{local:LocalizationExtension uninstall_description}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <ui:Button Margin="0,0,12,0"
                           Command="{Binding CloseCommand}"
                           Content="{local:LocalizationExtension uninstall_cancel}" />
                <ui:Button Appearance="Danger"
                           Command="{Binding UninstallConfirmCommand}"
                           Content="{local:LocalizationExtension uninstall_confirm}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
