<ui:FluentWindow
    x:Class="PDownloader.Installer.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PDownloader.Installer.Utils"
    xmlns:pages="clr-namespace:PDownloader.Installer.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="PDownloader Installer"
    Width="850"
    Height="600"
    MinWidth="850"
    MinHeight="600"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Tabbed"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <Style x:Key="StepDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="StepDotActive"
               TargetType="Ellipse"
               BasedOn="{StaticResource StepDot}">
            <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
        </Style>
        <Style x:Key="StepDotDone"
               TargetType="Ellipse"
               BasedOn="{StaticResource StepDot}">
            <Setter Property="Fill" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
        </Style>

        <Style x:Key="SideLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="SideLabelActive"
               TargetType="TextBlock"
               BasedOn="{StaticResource SideLabel}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="24,80,16,24">
                <StackPanel Margin="0,0,0,32" Orientation="Horizontal">
                    <Image Width="36"
                           Height="36"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="/Assets/app-256.png" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="PDownloader" />
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Setup" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="SideSteps"
                            Visibility="{Binding ViewModel.IsUninstallMode,
                                Converter={StaticResource BoolToVisibilityInverted},
                                FallbackValue=Visible}">
                    <StackPanel Margin="0,6" Orientation="Horizontal">
                        <Ellipse Style="{Binding ViewModel.StepIndex, Converter={StaticResource StepDotConverter}, ConverterParameter=1}" />
                        <TextBlock Style="{Binding ViewModel.StepIndex, Converter={StaticResource SideLabelConverter}, ConverterParameter=1}"
                                   Text="{local:LocalizationExtension welcome_title}" />
                    </StackPanel>
                    <StackPanel Margin="0,6" Orientation="Horizontal">
                        <Ellipse Style="{Binding ViewModel.StepIndex, Converter={StaticResource StepDotConverter}, ConverterParameter=2}" />
                        <TextBlock Style="{Binding ViewModel.StepIndex, Converter={StaticResource SideLabelConverter}, ConverterParameter=2}"
                                   Text="{local:LocalizationExtension license_title}" />
                    </StackPanel>
                    <StackPanel Margin="0,6" Orientation="Horizontal">
                        <Ellipse Style="{Binding ViewModel.StepIndex, Converter={StaticResource StepDotConverter}, ConverterParameter=3}" />
                        <TextBlock Style="{Binding ViewModel.StepIndex, Converter={StaticResource SideLabelConverter}, ConverterParameter=3}"
                                   Text="{local:LocalizationExtension path_title}" />
                    </StackPanel>
                    <StackPanel Margin="0,6" Orientation="Horizontal">
                        <Ellipse Style="{Binding ViewModel.StepIndex, Converter={StaticResource StepDotConverter}, ConverterParameter=4}" />
                        <TextBlock Style="{Binding ViewModel.StepIndex, Converter={StaticResource SideLabelConverter}, ConverterParameter=4}"
                                   Text="{local:LocalizationExtension options_title}" />
                    </StackPanel>
                    <StackPanel Margin="0,6" Orientation="Horizontal">
                        <Ellipse Style="{Binding ViewModel.StepIndex, Converter={StaticResource StepDotConverter}, ConverterParameter=5}" />
                        <TextBlock Style="{Binding ViewModel.StepIndex, Converter={StaticResource SideLabelConverter}, ConverterParameter=5}"
                                   Text="{local:LocalizationExtension installing_title}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1"
                        Margin="0,32,0,0"
                        Content="{Binding ViewModel}">
            <ContentControl.Resources>
                <DataTemplate x:Key="LanguageTemplate">
                    <pages:LanguagePage />
                </DataTemplate>
                <DataTemplate x:Key="WelcomeTemplate">
                    <pages:WelcomePage />
                </DataTemplate>
                <DataTemplate x:Key="LicenseTemplate">
                    <pages:LicensePage />
                </DataTemplate>
                <DataTemplate x:Key="InstallPathTemplate">
                    <pages:InstallPathPage />
                </DataTemplate>
                <DataTemplate x:Key="OptionsTemplate">
                    <pages:OptionsPage />
                </DataTemplate>
                <DataTemplate x:Key="InstallingTemplate">
                    <pages:InstallingPage />
                </DataTemplate>
                <DataTemplate x:Key="FinishTemplate">
                    <pages:FinishPage />
                </DataTemplate>
                <DataTemplate x:Key="ErrorTemplate">
                    <pages:ErrorPage />
                </DataTemplate>
                <DataTemplate x:Key="UninstallConfirmTemplate">
                    <pages:UninstallConfirmPage />
                </DataTemplate>
                <DataTemplate x:Key="UninstallingTemplate">
                    <pages:UninstallingPage />
                </DataTemplate>
                <DataTemplate x:Key="UninstallDoneTemplate">
                    <pages:UninstallDonePage />
                </DataTemplate>
            </ContentControl.Resources>

            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.Step}" Value="Language">
                            <Setter Property="ContentTemplate" Value="{StaticResource LanguageTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ViewModel.Step}" Value="Welcome">
                            <Setter Property="ContentTemplate" Value="{StaticResource WelcomeTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ViewModel.Step}" Value="License">
                            <Setter Property="ContentTemplate" Value="{StaticResource LicenseTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ViewModel.Step}" Value="InstallPath">
                            <Setter Property="ContentTemplate" Value="{StaticResource InstallPathTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ViewModel.Step}" Value="Options">
                            <Setter Property="ContentTemplate" Value="{StaticResource OptionsTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ViewModel.Step}" Value="Installing">
                            <Setter Property="ContentTemplate" Value="{StaticResource InstallingTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ViewModel.Step}" Value="Finish">
                            <Setter Property="ContentTemplate" Value="{StaticResource FinishTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ViewModel.Step}" Value="Error">
                            <Setter Property="ContentTemplate" Value="{StaticResource ErrorTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ViewModel.Step}" Value="UninstallConfirm">
                            <Setter Property="ContentTemplate" Value="{StaticResource UninstallConfirmTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ViewModel.Step}" Value="Uninstalling">
                            <Setter Property="ContentTemplate" Value="{StaticResource UninstallingTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ViewModel.Step}" Value="UninstallDone">
                            <Setter Property="ContentTemplate" Value="{StaticResource UninstallDoneTemplate}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <ui:TitleBar Grid.ColumnSpan="2"
                     VerticalAlignment="Top"
                     ShowMaximize="False"
                     ShowMinimize="True"
                     Title="" />
    </Grid>
</ui:FluentWindow>
