<Application x:Class="PDownloader.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helper="clr-namespace:PDownloader.Installer.Helpers"
             Startup="OnStartup"
             Exit="OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <helper:StepDotStyleConverter    x:Key="StepDotConverter"/>
            <helper:SideLabelStyleConverter  x:Key="SideLabelConverter"/>
            <helper:BoolToVisibilityConverter         x:Key="BoolToVisibility"/>
            <helper:BoolToVisibilityInvertedConverter x:Key="BoolToVisibilityInverted"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
