<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <LangVersion>preview</LangVersion>
    <Company>SM SOFT</Company>
    <AssemblyVersion>0.9.1.0</AssemblyVersion>
    <FileVersion>0.9.1.0</FileVersion>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Authors>Song Mai Software</Authors>
	<AssemblyName>PDownloader Core</AssemblyName>
    <!--<PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>-->
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PDownloader.CFS\PDownloader.CFS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ExtFiles Include="Ext\**\*" />
  </ItemGroup>

  <Target Name="CopyExtFiles" AfterTargets="Build">
    <Copy SourceFiles="@(ExtFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyExtFiles" AfterTargets="Publish">
    <Copy SourceFiles="@(ExtFiles)" DestinationFiles="@(ExtFiles->'$(PublishDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
