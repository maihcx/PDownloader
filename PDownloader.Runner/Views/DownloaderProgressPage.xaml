<Page x:Class="PDownloader.Runner.Views.DownloaderProgressPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PDownloader.Runner.Views"
      xmlns:controls="clr-namespace:PDownloader.Runner.Controls"
      xmlns:models="clr-namespace:PDownloader.Runner.Models"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:utils="clr-namespace:PDownloader.Runner.Utils"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance local:DownloaderProgressPage,
                               IsDesignTimeCreatable=False}"
      d:DesignHeight="400"
      d:DesignWidth="600"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="DownloaderPage"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <Style x:Key="DownloadProgressBar"
               TargetType="ProgressBar"
               BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Foreground"
                    Value="{DynamicResource SystemAccentColorPrimaryBrush}" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.CurrentDownloadStatus}"
                             Value="{x:Static models:DownloadStatus.Completed}">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.CurrentDownloadStatus}"
                             Value="{x:Static models:DownloadStatus.Error}">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.CurrentDownloadStatus}"
                             Value="{x:Static models:DownloadStatus.Paused}">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.CurrentDownloadStatus}"
                             Value="{x:Static models:DownloadStatus.Merging}">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:CardAction Grid.Row="0"
                           Padding="8 10"
                           IsChevronVisible="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="📄"
                               FontSize="28"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding ViewModel.RunnerConfig.FileName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ViewModel.RunnerConfig.InitialUrl}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </ui:CardAction>

            <StackPanel Grid.Row="1"
                        Margin="0 8 0 0">
                <TextBlock Text="{Binding ViewModel.StatusText}"
                           FontSize="11" />

                <ProgressBar Style="{StaticResource DownloadProgressBar}"
                             Height="10"
                             Margin="0 4 0 0"
                             Value="{Binding ViewModel.ProgressPercent, Mode=OneWay}"
                             Maximum="100" />

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding ViewModel.ProgressText}"
                               FontSize="13"
                               FontWeight="Bold" />
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal">
                        <TextBlock Text="{Binding ViewModel.DownloadedText}"
                                   FontSize="11" />
                        <TextBlock Text=" / "
                                   FontSize="11" />
                        <TextBlock Text="{Binding ViewModel.TotalText}"
                                   FontSize="11" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal">
                        <TextBlock Text="↓ "
                                   FontSize="12" />
                        <TextBlock Text="{Binding ViewModel.SpeedText}"
                                   FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <TextBlock Text="ETA: "
                                   FontSize="12" />
                        <TextBlock Text="{Binding ViewModel.EtaText}"
                                   FontSize="12" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- This row owns all remaining vertical space so the thread list
                 automatically follows the current Runner window height. -->
            <Grid Grid.Row="2"
                  Margin="0,10,0,0">
                <Border Padding="10"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        Visibility="{Binding ViewModel.IsThreadProgressVisible,
                                     Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding ViewModel.ThreadProgressTitle}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Top"
                                      ui:SmoothScrollBehavior.IsEnabled="True">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}"
                                       BasedOn="{StaticResource {x:Type ScrollBar}}">

                                    <Setter Property="Opacity"
                                            Value="0" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}"
                                                     Value="True">

                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="1"
                                                                         Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>

                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="0"
                                                                         Duration="0:0:0.4" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>

                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Resources>

                            <ItemsControl ItemsSource="{Binding ViewModel.ThreadProgress}"
                                           VerticalAlignment="Top">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Margin="0,0,-4,-4">
                                            <UniformGrid.Columns>
                                                <MultiBinding Converter="{StaticResource WidthToColumnsConverter}">
                                                    <!-- ActualWidth -->
                                                    <Binding Path="ActualWidth"
                                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}" />

                                                    <!-- Safety minimum only. Item count decides the preferred column count. -->
                                                    <Binding Source="150" />

                                                    <!-- MaxColumns -->
                                                    <Binding Source="4" />

                                                    <!-- ItemCount: used to avoid an orphan card on the last row. -->
                                                    <Binding Path="Items.Count"
                                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </UniformGrid.Columns>
                                        </UniformGrid>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:ThreadProgressCell Margin="0,0,4,4"
                                                                     Title="{Binding Title}"
                                                                     SpeedText="{Binding SpeedText}"
                                                                     BytesText="{Binding BytesText}"
                                                                     ProgressText="{Binding ProgressText}"
                                                                     Progress="{Binding Progress, Mode=OneWay}"
                                                                     State="{Binding State}"
                                                                     OverallStatus="{Binding DataContext.ViewModel.CurrentDownloadStatus,
                                                                                     RelativeSource={RelativeSource AncestorType=Page}}"
                                                                     IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Lightweight compact status: no card and no duplicated status icon.
                     This also fits the smaller Compact window height without clipping. -->
                <StackPanel MaxWidth="430"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ViewModel.IsCompactStatusVisible,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ViewModel.CompactStatusTitle}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="{Binding ViewModel.CompactStatusDescription}"
                               Margin="0,5,0,0"
                               MaxWidth="390"
                               FontSize="11"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Opacity="0.6" />
                </StackPanel>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0 8 0 0">
            <Border Visibility="{Binding ViewModel.DownloaderStatus.State,
                    Converter={StaticResource EnumToVisibilityConverter},
                    ConverterParameter=Downloading}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0"
                               Text="{utils:Localization sending_command_title}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Visibility="{Binding ViewModel.DownloaderStatus.IsSending, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <ui:Button Grid.Column="1"
                               Margin="0,0,8,0"
                               Content="{utils:Localization pause_title}"
                               Command="{Binding ViewModel.PauseCommand}"
                               Visibility="{Binding ViewModel.DownloaderStatus.IsPaused, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
                               IsEnabled="{Binding ViewModel.IsActionButtonEnabled, Mode=OneWay}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Pause16" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Grid.Column="1"
                               Margin="0,0,8,0"
                               Content="{utils:Localization resume_title}"
                               Command="{Binding ViewModel.ResumeCommand}"
                               Visibility="{Binding ViewModel.DownloaderStatus.IsPaused, Converter={StaticResource BoolToVisibilityConverter}}"
                               IsEnabled="{Binding ViewModel.IsActionButtonEnabled, Mode=OneWay}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Play16" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Grid.Column="2"
                               Content="{utils:Localization cancel_title}"
                               Appearance="Danger"
                               Command="{Binding ViewModel.CancelDownloadCommand}"
                               IsEnabled="{Binding ViewModel.IsActionButtonEnabled, Mode=OneWay}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Stop16" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>

            <Border Visibility="{Binding ViewModel.DownloaderStatus.State,
                    Converter={StaticResource EnumToVisibilityConverter},
                    ConverterParameter=Completed}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="CheckboxChecked16"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="{utils:Localization status_completed_title}"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="3 0 0 0" />
                    </StackPanel>

                    <ui:Button Grid.Column="1"
                               Content="{utils:Localization open_folder_title}"
                               Margin="0,0,8,0"
                               Command="{Binding ViewModel.OpenFolderCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen16" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Grid.Column="2"
                               Appearance="Primary"
                               Content="{utils:Localization open_file_title}"
                               Command="{Binding ViewModel.OpenFileCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Open16" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>
