<UserControl x:Class="PDownloader.Runner.Controls.ThreadProgressCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PDownloader.Runner.Models"
             x:Name="Root"
             MinHeight="50"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <UserControl.Resources>
        <Style x:Key="ThreadStateBackgroundStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="Opacity"
                    Value="0.04" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State, ElementName=Root}"
                             Value="Completed">
                    <Setter Property="Background"
                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallStatus, ElementName=Root}"
                             Value="{x:Static models:DownloadStatus.Paused}">
                    <Setter Property="Background"
                            Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallStatus, ElementName=Root}"
                             Value="{x:Static models:DownloadStatus.Merging}">
                    <Setter Property="Background"
                            Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallStatus, ElementName=Root}"
                             Value="{x:Static models:DownloadStatus.Completed}">
                    <Setter Property="Background"
                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallStatus, ElementName=Root}"
                             Value="{x:Static models:DownloadStatus.Error}">
                    <Setter Property="Background"
                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThreadProgressFillStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="Opacity"
                    Value="0.17" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State, ElementName=Root}"
                             Value="Completed">
                    <Setter Property="Background"
                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallStatus, ElementName=Root}"
                             Value="{x:Static models:DownloadStatus.Paused}">
                    <Setter Property="Background"
                            Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallStatus, ElementName=Root}"
                             Value="{x:Static models:DownloadStatus.Merging}">
                    <Setter Property="Background"
                            Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallStatus, ElementName=Root}"
                             Value="{x:Static models:DownloadStatus.Completed}">
                    <Setter Property="Background"
                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallStatus, ElementName=Root}"
                             Value="{x:Static models:DownloadStatus.Error}">
                    <Setter Property="Background"
                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="SurfaceBorder"
            BorderThickness="1"
            CornerRadius="{DynamicResource ControlCornerRadius}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            ClipToBounds="True">
        <Grid x:Name="ProgressSurface">
            <Border x:Name="StateBackground"
                    Style="{StaticResource ThreadStateBackgroundStyle}"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />

            <Border x:Name="ProgressFill"
                    Style="{StaticResource ThreadProgressFillStyle}"
                    HorizontalAlignment="Left"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />

            <Grid Margin="8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Title, ElementName=Root}"
                               FontSize="11"
                               FontWeight="SemiBold" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding SpeedText, ElementName=Root}"
                               FontSize="10"
                               Opacity="0.72" />
                </Grid>

                <Border Grid.Row="1"
                        Height="1"
                        Margin="0,5,0,4"
                        Background="{DynamicResource TextFillColorPrimaryBrush}"
                        Opacity="0.10" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding BytesText, ElementName=Root}"
                               FontSize="9"
                               Opacity="0.62" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressText, ElementName=Root}"
                               FontSize="9"
                               Opacity="0.62" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
