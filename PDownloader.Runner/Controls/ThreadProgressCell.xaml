<UserControl x:Class="PDownloader.Runner.Controls.ThreadProgressCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinHeight="50"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Border x:Name="SurfaceBorder"
            BorderThickness="1"
            CornerRadius="{DynamicResource ControlCornerRadius}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            ClipToBounds="True">
        <Grid x:Name="ProgressSurface">
            <!-- The whole cell is the progress surface. The base tint communicates
                 the state even while progress is still 0%. -->
            <Border x:Name="StateBackground"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />

            <!-- Filled portion of the cell. Its width follows Progress. -->
            <Border x:Name="ProgressFill"
                    HorizontalAlignment="Left"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />

            <Grid Margin="8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Title, ElementName=Root}"
                               FontSize="11"
                               FontWeight="SemiBold" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding SpeedText, ElementName=Root}"
                               FontSize="10"
                               Opacity="0.72" />
                </Grid>

                <!-- Separator replaces the small per-cell ProgressBar. -->
                <Border Grid.Row="1"
                        Height="1"
                        Margin="0,5,0,4"
                        Background="{DynamicResource TextFillColorPrimaryBrush}"
                        Opacity="0.10" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding BytesText, ElementName=Root}"
                               FontSize="9"
                               Opacity="0.62" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressText, ElementName=Root}"
                               FontSize="9"
                               Opacity="0.62" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
