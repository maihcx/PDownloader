<Page x:Class="PDownloader.TorrentShell.Views.DownloaderProgressPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:downloads="clr-namespace:PDownloader.Contracts.Downloads;assembly=PDownloader.Contracts"
      xmlns:local="clr-namespace:PDownloader.TorrentShell.Views"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:utils="clr-namespace:PDownloader.TorrentShell.Utils"
      Title="DownloaderProgressPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      d:DataContext="{d:DesignInstance local:DownloaderProgressPage, IsDesignTimeCreatable=False}"
      d:DesignHeight="540"
      d:DesignWidth="760"
      mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="TorrentProgressBarStyle"
               TargetType="ProgressBar"
               BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Foreground"
                    Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}"
                             Value="{x:Static downloads:DownloadStatus.Completed}">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}"
                             Value="{x:Static downloads:DownloadStatus.Error}">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}"
                             Value="{x:Static downloads:DownloadStatus.Paused}">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverallTorrentProgressBarStyle"
               TargetType="ProgressBar"
               BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Foreground"
                    Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.OverallStatus, Mode=OneWay}"
                             Value="{x:Static downloads:DownloadStatus.Completed}">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.OverallStatus, Mode=OneWay}"
                             Value="{x:Static downloads:DownloadStatus.Error}">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.OverallStatus, Mode=OneWay}"
                             Value="{x:Static downloads:DownloadStatus.Paused}">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.OverallStatus, Mode=OneWay}"
                             Value="{x:Static downloads:DownloadStatus.Merging}">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="4,6,4,12"
                Padding="14"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock Text="{Binding ViewModel.TorrentConfig.TorrentName, Mode=OneWay}"
                                      FontSize="18"
                                      FontWeight="SemiBold"
                                      TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Text="{Binding ViewModel.ProgressSummary, Mode=OneWay}"
                                      Margin="0,3,0,0"
                                      FontSize="11"
                                      Opacity="0.62" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <ui:TextBlock Text="{Binding ViewModel.OverallProgress, Mode=OneWay, StringFormat={}{0:F0}%}"
                                      FontSize="18"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Right" />
                        <ui:TextBlock Text="{Binding ViewModel.OverallSpeedText, Mode=OneWay}"
                                      FontSize="11"
                                      Opacity="0.62"
                                      HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
                <ProgressBar Grid.Row="1"
                             Margin="0,12,0,6"
                             Height="10"
                             Minimum="0"
                             Maximum="100"
                             Style="{StaticResource OverallTorrentProgressBarStyle}"
                             Value="{Binding ViewModel.OverallProgress, Mode=OneWay}" />
                <ui:TextBlock Grid.Row="2"
                              FontSize="11"
                              Opacity="0.62">
                    <Run Text="{Binding ViewModel.OverallDownloadedText, Mode=OneWay}" />
                    <Run Text=" / " />
                    <Run Text="{Binding ViewModel.OverallTotalText, Mode=OneWay}" />
                </ui:TextBlock>
            </Grid>
        </Border>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding ViewModel.Files, Mode=OneWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ui:SmoothScrollBehavior.IsEnabled="True">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="4,0,4,8" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14,11"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <ui:TextBlock Text="{Binding FileName, Mode=OneWay}"
                                              FontWeight="SemiBold"
                                              TextTrimming="CharacterEllipsis" />
                                <ui:TextBlock Text="{Binding RelativePath, Mode=OneWay}"
                                              Margin="0,2,0,7"
                                              FontSize="11"
                                              Opacity="0.52"
                                              TextTrimming="CharacterEllipsis" />
                                <ProgressBar Height="8"
                                             Minimum="0"
                                             Maximum="100"
                                             Style="{StaticResource TorrentProgressBarStyle}"
                                             Value="{Binding Progress, Mode=OneWay}" />
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Grid.Column="0"
                                                  Text="{Binding StatusText, Mode=OneWay}"
                                                  FontSize="11"
                                                  Opacity="0.7"
                                                  TextTrimming="CharacterEllipsis" />
                                    <ui:TextBlock Grid.Column="1" FontSize="11" Opacity="0.7">
                                        <Run Text="{Binding DownloadedText, Mode=OneWay}" />
                                        <Run Text=" / " />
                                        <Run Text="{Binding TotalText, Mode=OneWay}" />
                                        <Run Text="  ·  " />
                                        <Run Text="{Binding SpeedText, Mode=OneWay}" />
                                    </ui:TextBlock>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <ui:Button Margin="0,0,4,0"
                                           Icon="{ui:SymbolIcon Pause24}"
                                           ToolTip="{utils:Localization torrent_shell_pause}"
                                           IsEnabled="{Binding CanPause, Mode=OneWay}"
                                           Command="{Binding DataContext.ViewModel.PauseCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding Mode=OneWay}" />
                                <ui:Button Margin="0,0,4,0"
                                           Icon="{ui:SymbolIcon Play24}"
                                           ToolTip="{utils:Localization torrent_shell_resume}"
                                           IsEnabled="{Binding CanResume, Mode=OneWay}"
                                           Command="{Binding DataContext.ViewModel.ResumeCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding Mode=OneWay}" />
                                <ui:Button Margin="0,0,4,0"
                                           Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                                           ToolTip="{utils:Localization torrent_shell_retry}"
                                           IsEnabled="{Binding HasError, Mode=OneWay}"
                                           Command="{Binding DataContext.ViewModel.RetryCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding Mode=OneWay}" />
                                <ui:Button Margin="0,0,4,0"
                                           Icon="{ui:SymbolIcon FolderOpen24}"
                                           ToolTip="{utils:Localization torrent_shell_open_folder}"
                                           IsEnabled="{Binding IsCompleted, Mode=OneWay}"
                                           Command="{Binding DataContext.ViewModel.OpenFolderCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding Mode=OneWay}" />
                                <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                           Appearance="Danger"
                                           ToolTip="{utils:Localization torrent_shell_cancel}"
                                           IsEnabled="{Binding CanCancel, Mode=OneWay}"
                                           Command="{Binding DataContext.ViewModel.CancelCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                Padding="4,12,4,2"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBlock Text="{utils:Localization torrent_shell_completed}"
                              Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Visibility="{Binding ViewModel.IsComplete, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ui:Button Grid.Column="1"
                           Margin="0,0,8,0"
                           Content="{utils:Localization torrent_shell_pause}"
                           Icon="{ui:SymbolIcon Pause16}"
                           Command="{Binding ViewModel.PauseAllCommand, Mode=OneWay}"
                           IsEnabled="{Binding ViewModel.CanPauseAll, Mode=OneWay}"
                           Visibility="{Binding ViewModel.IsPauseControlVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ui:Button Grid.Column="1"
                           Margin="0,0,8,0"
                           Content="{utils:Localization torrent_shell_resume}"
                           Icon="{ui:SymbolIcon Play16}"
                           Command="{Binding ViewModel.ResumeAllCommand, Mode=OneWay}"
                           IsEnabled="{Binding ViewModel.CanResumeAll, Mode=OneWay}"
                           Visibility="{Binding ViewModel.IsResumeControlVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ui:Button Grid.Column="2"
                           Content="{utils:Localization torrent_shell_cancel}"
                           Icon="{ui:SymbolIcon Stop16}"
                           Appearance="Danger"
                           Command="{Binding ViewModel.CancelAllCommand, Mode=OneWay}"
                           IsEnabled="{Binding ViewModel.CanCancelAll, Mode=OneWay}"
                           Visibility="{Binding ViewModel.IsCancelControlVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</Page>
