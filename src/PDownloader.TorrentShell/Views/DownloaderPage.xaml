<Page x:Class="PDownloader.TorrentShell.Views.DownloaderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PDownloader.TorrentShell.Views"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:utils="clr-namespace:PDownloader.TorrentShell.Utils"
      Title="DownloaderPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      d:DataContext="{d:DesignInstance local:DownloaderPage, IsDesignTimeCreatable=False}"
      d:DesignHeight="540"
      d:DesignWidth="760"
      mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="6,6,6,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <ui:TextBlock Text="{Binding ViewModel.TorrentConfig.TorrentName, Mode=OneWay}"
                              FontSize="20"
                              FontWeight="SemiBold"
                              TextTrimming="CharacterEllipsis" />
                <ui:TextBlock Text="{utils:Localization torrent_shell_description}"
                              Margin="0,4,16,0"
                              Opacity="0.62"
                              TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom">
                <ui:Button Content="{utils:Localization torrent_shell_select_all}"
                           Command="{Binding ViewModel.SelectAllCommand, Mode=OneWay}" />
                <ui:Button Content="{utils:Localization torrent_shell_clear}"
                           Margin="8,0,0,0"
                           Command="{Binding ViewModel.SelectNoneCommand, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <ListBox Grid.Row="1"
                 Padding="0,3"
                 ItemsSource="{Binding ViewModel.TorrentConfig.Files, Mode=OneWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ui:SmoothScrollBehavior.IsEnabled="True">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="4,3" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder"
                                        Padding="14,10"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder"
                                                Property="Background"
                                                Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                        <StackPanel Grid.Column="1">
                            <ui:TextBlock Text="{Binding FileName, Mode=OneWay}"
                                          FontWeight="SemiBold"
                                          TextTrimming="CharacterEllipsis" />
                            <ui:TextBlock Text="{Binding RelativePath, Mode=OneWay}"
                                          Margin="0,3,12,0"
                                          FontSize="11"
                                          Opacity="0.58"
                                          TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <ui:TextBlock Grid.Column="2"
                                      Text="{Binding SizeText, Mode=OneWay}"
                                      VerticalAlignment="Center"
                                      Opacity="0.7" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                Padding="6,14,6,2"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock Text="{Binding ViewModel.SelectionSummary, Mode=OneWay}"
                                  FontWeight="SemiBold" />
                    <ui:TextBlock Text="{Binding ViewModel.ErrorMessage, Mode=OneWay}"
                                  Margin="0,3,12,0"
                                  Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                  TextWrapping="Wrap"
                                  Visibility="{Binding ViewModel.HasError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <ui:Button Grid.Column="1"
                           Margin="0,0,8,0"
                           Content="{utils:Localization torrent_shell_cancel}"
                           Command="{Binding ViewModel.CancelCommand, Mode=OneWay}" />
                <ui:Button Grid.Column="2"
                           MinWidth="122"
                           Appearance="Primary"
                           Content="{utils:Localization torrent_shell_start}"
                           Icon="{ui:SymbolIcon ArrowDownload24}"
                           Command="{Binding ViewModel.StartDownloadCommand, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
