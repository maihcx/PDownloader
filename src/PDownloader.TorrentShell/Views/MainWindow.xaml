<ui:FluentWindow x:Class="PDownloader.TorrentShell.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:local="clr-namespace:PDownloader.TorrentShell.Views"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:utils="clr-namespace:PDownloader.TorrentShell.Utils"
                 Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
                 Width="780"
                 Height="620"
                 MinWidth="680"
                 MinHeight="500"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Tabbed"
                 WindowCornerPreference="Round"
                 ShowActivated="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 d:DataContext="{d:DesignInstance local:MainWindow, IsDesignTimeCreatable=False}"
                 mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
                     CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-256.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Frame x:Name="FrameHostContent"
               Grid.Row="1"
               Padding="17,0,17,16"
               NavigationUIVisibility="Hidden" />
    </Grid>
</ui:FluentWindow>
