<UserControl x:Class="PDownloader.Installer.Views.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PDownloader.Installer.Utils"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="40,32">
        <StackPanel>
            <ui:TextBlock Margin="0,0,0,6"
                          FontSize="26"
                          FontWeight="Bold"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          Text="{local:LocalizationExtension welcome_summary}"
                          TextWrapping="Wrap" />
            <ui:TextBlock Margin="0,0,0,24"
                          FontSize="13"
                          Foreground="{DynamicResource SystemAccentColorPrimaryBrush}">
                <Run Text="{local:LocalizationExtension version_title}" />
                <Run Text=":" />
                <Run Text="{Binding AppVersion, Mode=OneWay}" />
            </ui:TextBlock>
            <ui:TextBlock Margin="0,0,0,40"
                          FontSize="14"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          LineHeight="22"
                          Text="{local:LocalizationExtension welcome_description}"
                          TextWrapping="Wrap" />
        </StackPanel>
        <ui:Button HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Appearance="Primary"
                   Command="{Binding NextFromWelcomeCommand}"
                   Content="{local:LocalizationExtension welcome_next}"
                   Icon="{ui:SymbolIcon ChevronRight24}" />
    </Grid>
</UserControl>
