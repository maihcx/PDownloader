<UserControl x:Class="PDownloader.Installer.Views.Pages.ErrorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PDownloader.Installer.Utils"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="40,32">
        <StackPanel VerticalAlignment="Center">
            <ui:SymbolIcon Margin="0,0,0,20"
                           FontSize="56"
                           Foreground="OrangeRed"
                           Symbol="DismissCircle48" />
            <ui:TextBlock Margin="0,0,0,10"
                       HorizontalAlignment="Center"
                       FontSize="24"
                       FontWeight="Bold"
                       Text="{local:LocalizationExtension error_title}" />
            <ui:TextBlock Margin="0,0,0,12"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{local:LocalizationExtension error_description}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <ui:TextBlock Margin="0,0,0,32"
                       HorizontalAlignment="Center"
                       FontFamily="Consolas"
                       FontSize="12"
                       Foreground="OrangeRed"
                       Text="{Binding ErrorDetail}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <Button HorizontalAlignment="Center"
                    Command="{Binding CloseCommand}"
                    Content="{local:LocalizationExtension error_close}" />
        </StackPanel>
    </Grid>
</UserControl>
