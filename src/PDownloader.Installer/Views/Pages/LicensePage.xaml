<UserControl x:Class="PDownloader.Installer.Views.Pages.LicensePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PDownloader.Installer.Utils"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TextBlock Grid.Row="0"
                      Margin="0,0,0,16"
                      FontSize="22"
                      FontWeight="Bold"
                      Text="{local:LocalizationExtension license_title}" />

        <Border Grid.Row="1"
                Margin="0,0,0,12"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <ScrollViewer Padding="12">
                <ui:TextBlock FontFamily="Consolas"
                              FontSize="12"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{Binding LicenseText}"
                              TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <CheckBox Grid.Row="2"
                  Margin="0,0,0,16"
                  Content="{local:LocalizationExtension license_accept}"
                  IsChecked="{Binding LicenseAccepted}" />

        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0"
                       Command="{Binding BackFromLicenseCommand}"
                       Content="{local:LocalizationExtension license_back}" />
            <ui:Button Appearance="Primary"
                       Command="{Binding NextFromLicenseCommand}"
                       Content="{local:LocalizationExtension license_next}"
                       Icon="{ui:SymbolIcon ChevronRight24}" />
        </StackPanel>
    </Grid>
</UserControl>
