<Page x:Class="PDownloader.Views.Pages.TorrentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PDownloader.Views.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:utils="clr-namespace:PDownloader.Utils"
      xmlns:controls="clr-namespace:PDownloader.Controls"
      Title="TorrentsPage"
      d:DataContext="{d:DesignInstance local:TorrentsPage, IsDesignTimeCreatable=False}"
      d:DesignHeight="600"
      d:DesignWidth="900"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="DownloadProgressBar"
               TargetType="ProgressBar"
               BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Foreground"
                    Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}"
                             Value="Completed">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}"
                             Value="Error">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}"
                             Value="Paused">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DownloadStatusIconStyle"
               TargetType="ui:SymbolIcon">
            <Setter Property="Foreground"
                    Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}"
                             Value="Completed">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}"
                             Value="Error">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}"
                             Value="Paused">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatListItemStyle"
               TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        Text="{Binding ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{utils:Localization download_filter_searchbox_desc}"
                        Icon="{ui:SymbolIcon Search24}"
                        VerticalContentAlignment="Center" />

            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding ViewModel.SortOptions, Mode=OneWay}"
                      SelectedItem="{Binding ViewModel.SelectedSortOption, Mode=TwoWay}"
                      DisplayMemberPath="DisplayValue"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <ui:SymbolIcon Symbol="ArrowDownload24"
                           FontSize="64"
                           Opacity="0.2"
                           HorizontalAlignment="Center" />
            <ui:TextBlock Text="{utils:Localization page_torrents_empty_title}"
                          Opacity="0.5"
                          FontSize="16"
                          FontWeight="SemiBold"
                          HorizontalAlignment="Center"
                          Margin="0,16,0,0" />
            <ui:TextBlock Text="{utils:Localization page_torrents_empty_hint}"
                          Opacity="0.35"
                          FontSize="13"
                          HorizontalAlignment="Center"
                          Margin="0,6,0,0" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding ViewModel.DownloadsView, Mode=OneWay}"
                 ItemContainerStyle="{StaticResource FlatListItemStyle}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ui:SmoothScrollBehavior.IsEnabled="True">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ui:CardExpander Margin="0,0,0,8">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Grid.Column="0"
                                               FontSize="22"
                                               Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource DownloadStatusIconStyle}"
                                               Symbol="{Binding StatusState, Mode=OneWay, Converter={StaticResource StatusToIconConverter}}" />

                                <StackPanel Grid.Column="1"
                                            Margin="0,0,14,0">
                                    <DockPanel LastChildFill="True">
                                        <ui:TextBlock DockPanel.Dock="Right"
                                                      Margin="12,0,0,0"
                                                      Text="{Binding ItemCountText, Mode=OneWay}"
                                                      FontSize="11"
                                                      Opacity="0.55"
                                                      Visibility="{Binding IsTorrentGroup, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                        <ui:TextBlock Text="{Binding Title, Mode=OneWay}"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <ui:TextBlock Text="{Binding Subtitle, Mode=OneWay}"
                                                  FontSize="11"
                                                  Opacity="0.45"
                                                  TextTrimming="CharacterEllipsis"
                                                  Margin="0,2,0,6" />
                                    <ProgressBar Style="{StaticResource DownloadProgressBar}"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 Height="9"
                                                 Maximum="100"
                                                 Minimum="0" />
                                    <ui:TextBlock FontSize="11"
                                                  Opacity="0.65"
                                                  Margin="0,4,0,0">
                                        <Run Text="{Binding DownloadedFormatted, Mode=OneWay}" />
                                        <Run Text=" / " />
                                        <Run Text="{Binding TotalFormatted, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding StatusText, Mode=OneWay}" />
                                    </ui:TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <ui:TextBlock Text="{Binding Progress, Mode=OneWay, StringFormat={}{0:F0}%}"
                                                  FontSize="13"
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Right" />
                                    <ui:TextBlock Text="{Binding SpeedFormatted, Mode=OneWay}"
                                                  FontSize="11"
                                                  Opacity="0.55"
                                                  HorizontalAlignment="Right" />
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,5,0,0">
                                        <ui:Button Icon="{ui:SymbolIcon Pause24}"
                                                   Margin="0,0,2,0"
                                                   ToolTip="{utils:Localization page_downloads_pause}"
                                                   Command="{Binding ViewModel.PauseGroupCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                   CommandParameter="{Binding Mode=OneWay}"
                                                   IsEnabled="{Binding CanPause, Mode=OneWay}" />
                                        <ui:Button Icon="{ui:SymbolIcon Play24}"
                                                   Margin="0,0,2,0"
                                                   ToolTip="{utils:Localization page_downloads_resume}"
                                                   Command="{Binding ViewModel.ResumeGroupCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                   CommandParameter="{Binding Mode=OneWay}"
                                                   IsEnabled="{Binding CanResume, Mode=OneWay}" />
                                        <ui:Button Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                                                   Margin="0,0,2,0"
                                                   ToolTip="{utils:Localization page_downloads_retry}"
                                                   Command="{Binding ViewModel.RetryGroupCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                   CommandParameter="{Binding Mode=OneWay}"
                                                   IsEnabled="{Binding CanRetry, Mode=OneWay}" />
                                        <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                                   Foreground="#AAEF5350"
                                                   ToolTip="{utils:Localization page_downloads_cancel}"
                                                   Command="{Binding ViewModel.CancelGroupCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                   CommandParameter="{Binding Mode=OneWay}"
                                                   IsEnabled="{Binding CanCancel, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ui:CardExpander.Header>

                        <ui:CardExpander.Content>
                            <ItemsControl ItemsSource="{Binding Items, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10"
                                                Margin="0,0,0,6"
                                                CornerRadius="6"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Row="0"
                                                            Grid.Column="0">
                                                    <ui:TextBlock Text="{Binding FileName, Mode=OneWay}"
                                                                  FontWeight="SemiBold"
                                                                  TextTrimming="CharacterEllipsis" />
                                                    <ui:TextBlock Text="{Binding TorrentRelativePath, Mode=OneWay}"
                                                                  FontSize="11"
                                                                  Opacity="0.5"
                                                                  TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="0"
                                                            Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Margin="12,0,0,0">
                                                    <ui:Button Icon="{ui:SymbolIcon Pause24}"
                                                               Margin="0,0,2,0"
                                                               ToolTip="{utils:Localization page_downloads_pause}"
                                                               Command="{Binding ViewModel.PauseCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                               CommandParameter="{Binding Mode=OneWay}"
                                                               IsEnabled="{Binding CanPause, Mode=OneWay}" />
                                                    <ui:Button Icon="{ui:SymbolIcon Play24}"
                                                               Margin="0,0,2,0"
                                                               ToolTip="{utils:Localization page_downloads_resume}"
                                                               Command="{Binding ViewModel.ResumeCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                               CommandParameter="{Binding Mode=OneWay}"
                                                               IsEnabled="{Binding CanResumeOrOpenFile, Mode=OneWay}" />
                                                    <ui:Button Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                                                               Margin="0,0,2,0"
                                                               ToolTip="{utils:Localization page_downloads_retry}"
                                                               Command="{Binding ViewModel.RetryCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                               CommandParameter="{Binding Mode=OneWay}" />
                                                    <ui:Button Icon="{ui:SymbolIcon FolderOpen24}"
                                                               Margin="0,0,2,0"
                                                               ToolTip="{utils:Localization page_downloads_open_folder}"
                                                               Command="{Binding ViewModel.OpenFolderCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                               CommandParameter="{Binding Mode=OneWay}" />
                                                    <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                                               Foreground="#AAEF5350"
                                                               ToolTip="{utils:Localization page_downloads_cancel}"
                                                               Command="{Binding ViewModel.CancelCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                               CommandParameter="{Binding Mode=OneWay}" />
                                                </StackPanel>

                                                <ProgressBar Grid.Row="1"
                                                             Grid.ColumnSpan="2"
                                                             Style="{StaticResource DownloadProgressBar}"
                                                             Value="{Binding Progress, Mode=OneWay}"
                                                             Height="7"
                                                             Maximum="100"
                                                             Minimum="0"
                                                             Margin="0,7,0,4" />

                                                <Grid Grid.Row="2"
                                                      Grid.ColumnSpan="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                                                  FontSize="11"
                                                                  Opacity="0.65"
                                                                  TextTrimming="CharacterEllipsis" />
                                                    <ui:TextBlock Grid.Column="1"
                                                                  FontSize="11"
                                                                  Opacity="0.65"
                                                                  Margin="12,0,0,0">
                                                        <Run Text="{Binding DownloadedFormatted, Mode=OneWay}" />
                                                        <Run Text=" / " />
                                                        <Run Text="{Binding TotalFormatted, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding SpeedFormatted, Mode=OneWay}" />
                                                    </ui:TextBlock>
                                                </Grid>

                                                <Grid.ToolTip>
                                                    <StackPanel MaxWidth="520">
                                                        <TextBlock Text="{Binding SavePath, Mode=OneWay}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Url, Mode=OneWay}"
                                                                   Margin="0,4,0,0"
                                                                   Opacity="0.7"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid.ToolTip>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ui:CardExpander.Content>
                    </ui:CardExpander>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                Padding="0,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBlock Grid.Column="0"
                              Text="{Binding ViewModel.StatusText, Mode=OneWay}"
                              Opacity="0.5"
                              FontSize="12"
                              VerticalAlignment="Center" />

                <ui:Flyout Grid.Column="1"
                           Margin="0,0,0,7"
                           Padding="6"
                           IsOpen="{Binding ViewModel.IsFlyoutOpen, Mode=TwoWay}"
                           Placement="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{utils:Localization page_downloads_action_delete_completed_title}"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Appearance="Caution"
                                   Command="{Binding ViewModel.DeleteAllCompletedCommand, Mode=OneWay}" />
                        <ui:Button Margin="4,0,0,0"
                                   Content="{utils:Localization page_downloads_action_delete_all_title}"
                                   Icon="{ui:SymbolIcon DeleteDismiss24}"
                                   Appearance="Danger"
                                   Command="{Binding ViewModel.DeleteAllCommand, Mode=OneWay}" />
                        <ui:Button Margin="4,0,0,0"
                                   Content="{utils:Localization page_downloads_action_pause_all_title}"
                                   Icon="{ui:SymbolIcon Pause24}"
                                   Command="{Binding ViewModel.PauseAllCommand, Mode=OneWay}" />
                        <ui:Button Margin="4,0,0,0"
                                   Content="{utils:Localization page_downloads_action_resume_all_title}"
                                   Icon="{ui:SymbolIcon Play24}"
                                   Appearance="Primary"
                                   Command="{Binding ViewModel.ResumeAllCommand, Mode=OneWay}" />
                        <ui:Button Margin="4,0,0,0"
                                   Content="{utils:Localization page_downloads_action_retry_all_title}"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Appearance="Info"
                                   Command="{Binding ViewModel.RetryAllCommand, Mode=OneWay}" />
                    </StackPanel>
                </ui:Flyout>

                <ui:Button Grid.Column="1"
                           Content="{utils:Localization page_downloads_action_title}"
                           Icon="{ui:SymbolIcon ExpandUpRight20}"
                           Appearance="Caution"
                           Command="{Binding ViewModel.OpenActionFlyoutCommand, Mode=OneWay}" />
                <ui:Button Grid.Column="3"
                           Content="{utils:Localization page_downloads_add_title}"
                           Icon="{ui:SymbolIcon AddCircle24}"
                           Appearance="Primary"
                           Command="{Binding ViewModel.AddCommand, Mode=OneWay}" />
                <ui:Button Grid.Column="5"
                           Content="{utils:Localization page_downloads_refresh_title}"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Appearance="Transparent"
                           Command="{Binding ViewModel.RefreshCommand, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
