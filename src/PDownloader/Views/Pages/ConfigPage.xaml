<Page x:Class="PDownloader.Views.Pages.ConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PDownloader.Views.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:utils="clr-namespace:PDownloader.Utils"
      Title="ConfigPage"
      d:DataContext="{d:DesignInstance local:ConfigPage, IsDesignTimeCreatable=False}"
      d:DesignHeight="450"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d"
      ScrollViewer.CanContentScroll="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="1"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" />

        <ScrollViewer ui:SmoothScrollBehavior.IsEnabled="True"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,8">
            <StackPanel>

                <!-- Download folders and file groups -->
                <ui:CardExpander Icon="{ui:SymbolIcon Folder24}"
                                 Margin="0,0,0,8"
                                 IsExpanded="True">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body"
                                          Text="{utils:Localization page_config_folder_title}"
                                          FontWeight="SemiBold"
                                          TextWrapping="Wrap" />
                            <ui:TextBlock Text="{utils:Localization page_config_folder_summary}"
                                       Opacity="0.6"
                                       FontSize="12" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{utils:Localization page_config_groups_root_title}"
                                      Margin="2,0,0,4"
                                      FontWeight="SemiBold" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding ViewModel.DownloadConfigs.DefaultDownloadFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{utils:Localization page_config_folder_placeholder}" />
                            <ui:Button Grid.Column="1"
                                       Margin="8,0,0,0"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       Content="{utils:Localization page_config_folder_browse}"
                                       Command="{Binding ViewModel.BrowseDownloadFolderCommand}" />
                        </Grid>

                        <ui:TextBlock Text="{utils:Localization page_config_groups_list_title}"
                                      Margin="2,0,0,4"
                                      FontWeight="SemiBold" />
                        <Grid MinHeight="310">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ListBox Grid.Row="0"
                                         ItemsSource="{Binding ViewModel.DownloadConfigs.DownloadCategories}"
                                         SelectedItem="{Binding ViewModel.SelectedDownloadCategory, Mode=TwoWay}"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Margin"
                                                    Value="4" />
                                            <Setter Property="Padding"
                                                    Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Border"
                                                                Padding="4"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver"
                                                                     Value="True">
                                                                <Setter TargetName="Border"
                                                                        Property="Background"
                                                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected"
                                                                     Value="True">
                                                                <Setter TargetName="Border"
                                                                        Property="Background"
                                                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource ListBoxItemSelectedForegroundThemeBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,3">
                                                <ui:TextBlock Text="{Binding Name}"
                                                              FontWeight="SemiBold"
                                                              TextTrimming="CharacterEllipsis" />
                                                <ui:TextBlock Text="{Binding FolderPath}"
                                                              Margin="0,2,0,0"
                                                              FontSize="10"
                                                              Opacity="0.58"
                                                              TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="1"
                                            Margin="0,8,0,0"
                                            Orientation="Horizontal">
                                    <ui:Button Content="＋"
                                               MinWidth="38"
                                               ToolTip="{utils:Localization page_config_groups_add}"
                                               Command="{Binding ViewModel.AddDownloadCategoryCommand}" />
                                    <ui:Button Content="−"
                                               MinWidth="38"
                                               Margin="6,0,0,0"
                                               ToolTip="{utils:Localization page_config_groups_remove}"
                                               Command="{Binding ViewModel.RemoveDownloadCategoryCommand}" />
                                    <ui:Button Content="↑"
                                               MinWidth="38"
                                               Margin="6,0,0,0"
                                               ToolTip="{utils:Localization page_config_groups_move_up}"
                                               Command="{Binding ViewModel.MoveDownloadCategoryUpCommand}" />
                                    <ui:Button Content="↓"
                                               MinWidth="38"
                                               Margin="6,0,0,0"
                                               ToolTip="{utils:Localization page_config_groups_move_down}"
                                               Command="{Binding ViewModel.MoveDownloadCategoryDownCommand}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.SelectedDownloadCategory}"
                                                         Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <ui:TextBlock Text="{utils:Localization page_config_groups_enabled_title}"
                                                      FontWeight="SemiBold" />
                                        <ui:TextBlock Text="{utils:Localization page_config_groups_enabled_summary}"
                                                      Margin="0,2,12,0"
                                                      FontSize="11"
                                                      Opacity="0.6"
                                                      TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1"
                                                     VerticalAlignment="Center"
                                                     IsChecked="{Binding ViewModel.SelectedDownloadCategory.IsEnabled, Mode=TwoWay}" />
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                    <ui:TextBlock Text="{utils:Localization page_config_groups_name_title}"
                                                  Margin="2,0,0,4" />
                                    <ui:TextBox Text="{Binding ViewModel.SelectedDownloadCategory.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                    <ui:TextBlock Text="{utils:Localization page_config_groups_path_title}"
                                                  Margin="2,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Text="{Binding ViewModel.SelectedDownloadCategory.FolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ui:Button Grid.Column="1"
                                                   Content="…"
                                                   Margin="6,0,0,0"
                                                   Padding="11,7"
                                                   Command="{Binding ViewModel.BrowseCategoryFolderCommand}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Row="3">
                                    <ui:TextBlock Text="{utils:Localization page_config_groups_extensions_title}"
                                                  Margin="2,0,0,4" />
                                    <ui:TextBox Text="{Binding ViewModel.SelectedDownloadCategory.ExtensionsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AcceptsReturn="True"
                                                TextWrapping="Wrap"
                                                MinHeight="62"
                                                VerticalContentAlignment="Top" />
                                    <ui:TextBlock Text="{utils:Localization page_config_groups_extensions_summary}"
                                                  Margin="2,4,0,0"
                                                  FontSize="11"
                                                  Opacity="0.6"
                                                  TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Temporary download data folder -->
                <ui:CardExpander Icon="{ui:SymbolIcon FolderOpen24}"
                                 Margin="0,0,0,8"
                                 IsExpanded="False">
                    <ui:CardExpander.Header>
                        <StackPanel Margin="0 0 4 0">
                            <ui:TextBlock FontTypography="Body"
                                          Text="{utils:Localization page_config_temp_folder_title}"
                                          FontWeight="SemiBold"
                                          TextWrapping="Wrap" />
                            <ui:TextBlock Text="{utils:Localization page_config_temp_folder_summary}"
                                       Opacity="0.6"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding ViewModel.DownloadConfigs.DefaultTempFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{utils:Localization page_config_temp_folder_placeholder}" />
                        <ui:Button Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Content="{utils:Localization page_config_temp_folder_default}"
                                   Command="{Binding ViewModel.ResetTempFolderCommand}" />
                        <ui:Button Grid.Column="2"
                                   Margin="8,0,0,0"
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Content="{utils:Localization page_config_folder_browse}"
                                   Command="{Binding ViewModel.BrowseTempFolderCommand}" />
                    </Grid>
                </ui:CardExpander>

                <!-- Thread count -->
                <ui:CardExpander Icon="{ui:SymbolIcon Symbol=Settings20}"
                                 Margin="0,0,0,8"
                                 IsExpanded="False">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body"
                                          Text="{utils:Localization page_config_threads_title}"
                                          FontWeight="SemiBold"
                                          TextWrapping="Wrap" />
                            <ui:TextBlock Text="{utils:Localization page_config_threads_summary}"
                                       Opacity="0.6"
                                       FontSize="12" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel Orientation="Horizontal">
                        <Slider Minimum="1"
                                Maximum="32"
                                Value="{Binding ViewModel.DownloadConfigs.DefaultThreadCount, Mode=TwoWay}"
                                Width="240"
                                VerticalAlignment="Center" />
                        <ui:TextBlock Text="{Binding ViewModel.DownloadConfigs.DefaultThreadCount, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,6,0"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <ui:TextBlock Text="{utils:Localization page_config_threads_unit}"
                                   VerticalAlignment="Center"
                                   Opacity="0.6"
                                   FontSize="12" />
                    </StackPanel>
                </ui:CardExpander>

                <!-- File merge mode -->
                <ui:CardExpander Icon="{ui:SymbolIcon Symbol=Settings20}"
                                 Margin="0,0,0,8"
                                 IsExpanded="False">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body"
                                          Text="{utils:Localization page_config_merge_mode_title}"
                                          FontWeight="SemiBold"
                                          TextWrapping="Wrap" />
                            <ui:TextBlock Text="{utils:Localization page_config_merge_mode_summary}"
                                       Opacity="0.6"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardExpander.Header>

                    <ComboBox ItemsSource="{Binding ViewModel.FileMergeModeOptions}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding ViewModel.DownloadConfigs.FileMergeMode,
                                  Mode=TwoWay,
                                  UpdateSourceTrigger=PropertyChanged}"
                              HorizontalContentAlignment="Stretch"
                              MinWidth="320"
                              MaxDropDownHeight="360"
                              IsTextSearchEnabled="False">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel MaxWidth="560"
                                            HorizontalAlignment="Left">
                                    <ui:TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />

                                    <ui:TextBlock Text="{Binding Description}"
                                               Margin="22,4,8,0"
                                               FontSize="12"
                                               Opacity="0.65"
                                               TextWrapping="Wrap">

                                        <ui:TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}}}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:TextBlock.Style>
                                    </ui:TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ComboBoxItem}"
                                   BasedOn="{StaticResource {x:Type ComboBoxItem}}">

                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch" />

                                <Setter Property="VerticalContentAlignment"
                                        Value="Center" />

                                <Setter Property="Padding"
                                        Value="20,10" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </ui:CardExpander>

                <!-- Download progress window behavior -->
                <ui:CardExpander Icon="{ui:SymbolIcon WindowSettings20}"
                                 Margin="0,0,0,8"
                                 IsExpanded="False">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body"
                                          Text="{utils:Localization page_config_progress_window_title}"
                                          FontWeight="SemiBold"
                                          TextWrapping="Wrap" />
                            <ui:TextBlock Text="{utils:Localization page_config_progress_window_summary}"
                                       Opacity="0.6"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardExpander.Header>

                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,16,0">
                                <ui:TextBlock Text="{utils:Localization page_config_progress_window_close_completed_title}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <ui:TextBlock Text="{utils:Localization page_config_progress_window_close_completed_summary}"
                                           Opacity="0.6"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding ViewModel.DownloadConfigs.CloseProgressWindowWhenDownloadCompletes, Mode=TwoWay}" />
                        </Grid>

                        <Separator Opacity="0.16"
                                   Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,16,0">
                                <ui:TextBlock Text="{utils:Localization page_config_progress_window_close_open_file_title}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <ui:TextBlock Text="{utils:Localization page_config_progress_window_close_open_file_summary}"
                                           Opacity="0.6"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding ViewModel.DownloadConfigs.CloseProgressWindowAfterOpeningFile, Mode=TwoWay}" />
                        </Grid>

                        <Separator Opacity="0.16"
                                   Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,16,0">
                                <ui:TextBlock Text="{utils:Localization page_config_progress_window_close_open_folder_title}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <ui:TextBlock Text="{utils:Localization page_config_progress_window_close_open_folder_summary}"
                                           Opacity="0.6"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding ViewModel.DownloadConfigs.CloseProgressWindowAfterOpeningFolder, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Padding="24,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0"
                           Text="{Binding ViewModel.StatusMessage}"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           FontSize="12" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <ui:Button Content="{utils:Localization page_config_save}"
                               Icon="{ui:SymbolIcon Save24}"
                               Appearance="Primary"
                               Command="{Binding ViewModel.SaveSettingsCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
