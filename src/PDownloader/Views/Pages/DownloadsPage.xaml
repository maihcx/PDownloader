<Page x:Class="PDownloader.Views.Pages.DownloadsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PDownloader.Views.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:utils="clr-namespace:PDownloader.Utils"
      xmlns:models="clr-namespace:PDownloader.Models"
      xmlns:helpers="clr-namespace:PDownloader.Helpers"
      xmlns:controls="clr-namespace:PDownloader.Controls"
      Title="DownloadsPage"
      d:DataContext="{d:DesignInstance local:DownloadsPage, IsDesignTimeCreatable=False}"
      d:DesignHeight="600"
      d:DesignWidth="900"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <Style x:Key="DownloadProgressBar"
               TargetType="ProgressBar"
               BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Foreground"
                    Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}"
                             Value="Completed">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Error">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Paused">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Merging">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="DownloadStatusIconStyle"
               TargetType="ui:SymbolIcon">
            <Setter Property="Foreground"
                    Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}"
                             Value="Completed">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Error">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Paused">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Merging">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DownloadStatusTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}"
                             Value="Completed">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Error">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Paused">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Merging">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DownloadStatusRunStyle"
               TargetType="Run">
            <Setter Property="Foreground"
                    Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}"
                             Value="Completed">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Error">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Paused">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="Merging">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <Grid Grid.Row="0"
              Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0"
                            Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{utils:Localization download_filter_searchbox_desc}"
                            Icon="{ui:SymbolIcon Search24}"
                            VerticalContentAlignment="Center" />

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding ViewModel.SortOptions}"
                          SelectedItem="{Binding ViewModel.SelectedSortOption, Mode=TwoWay}"
                          DisplayMemberPath="DisplayValue"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Center">
                </ComboBox>
            </Grid>

            <Border Grid.Row="2"
                    Padding="1"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" />
        </Grid>

        <!-- Data viewer -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"
                    Visibility="{Binding ViewModel.IsEmpty, Converter={StaticResource BoolToVisConverter}}">
            <ui:SymbolIcon Symbol="ArrowDownload24"
                           FontSize="64"
                           Opacity="0.2"
                           HorizontalAlignment="Center" />
            <ui:TextBlock Text="{utils:Localization page_downloads_empty_title}"
                       Opacity="0.5"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0" />
            <ui:TextBlock Text="{utils:Localization page_downloads_empty_hint}"
                       Opacity="0.35"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding ViewModel.Downloads}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ui:SmoothScrollBehavior.IsEnabled="True">

            <!-- Item Style -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch" />
                    <Setter Property="Padding"
                            Value="0" />
                    <Setter Property="Margin"
                            Value="0" />
                    <Setter Property="Focusable"
                            Value="False" />
                    <Setter Property="FocusVisualStyle"
                            Value="{x:Null}" />

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <!-- Item Content -->
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ui:CardExpander Margin="0,0,0,8">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="118" />
                                </Grid.ColumnDefinitions>

                                <!-- Status icon -->
                                <ui:SymbolIcon Grid.Column="0"
                                               FontSize="22"
                                               VerticalAlignment="Center"
                                               Margin="0,0,14,0"
                                               Style="{StaticResource DownloadStatusIconStyle}"
                                               Symbol="{Binding StatusState, Converter={StaticResource StatusToIconConverter}}" />

                                <!-- File info -->
                                <StackPanel Grid.Column="1"
                                            Margin="0 0 10 0"
                                            VerticalAlignment="Center">
                                    <ui:TextBlock Text="{Binding FileName}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <ui:TextBlock Text="{Binding Url}"
                                               FontSize="11"
                                               Opacity="0.45"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,6" />
                                    <ProgressBar Style="{StaticResource DownloadProgressBar}"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 Margin="0,0,0,4"
                                                 Height="10"
                                                 Maximum="100" 
                                                 Minimum="0" />
                                    <ui:TextBlock FontSize="11"
                                               Opacity="0.6">
                                        <Run Text="{Binding DownloadedFormatted, Mode=OneWay}" />
                                        <Run Text=" / " />
                                        <Run Text="{Binding TotalFormatted, Mode=OneWay}" />
                                        <Run Text="  " />
                                        <Run Style="{StaticResource DownloadStatusRunStyle}">
                                            <Run.Text>
                                                <MultiBinding Converter="{StaticResource StatusToTextConverter}"
                                                              Mode="OneWay">
                                                    <Binding Path="Status" />
                                                    <Binding Path="ErrorMessage" />
                                                </MultiBinding>
                                            </Run.Text>
                                        </Run>
                                    </ui:TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <!-- Progress % -->
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Speed + ETA -->
                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <ui:TextBlock Text="{Binding SpeedFormatted, Mode=OneWay}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <ui:TextBlock Text="{Binding EtaFormatted, Mode=OneWay}"
                                                       FontSize="11"
                                                       Opacity="0.5"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <ui:TextBlock Grid.Column="1"
                                                   VerticalAlignment="Top"
                                                   HorizontalAlignment="Right"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Style="{StaticResource DownloadStatusTextStyle}">
                                                <Run Text="{Binding Progress, Mode=OneWay, StringFormat={}{0:F0}%}" />
                                        </ui:TextBlock>
                                    </Grid>

                                    <!-- Action buttons -->
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0 5 0 0">
                                        <ui:Button Icon="{ui:SymbolIcon Pause24}"
                                                   Margin="0 0 2 0"
                                                   ToolTip="{utils:Localization page_downloads_pause}"
                                                   Command="{Binding DataContext.ViewModel.PauseCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}"
                                                   IsEnabled="{Binding StatusState, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=!~Connecting}"/>

                                        <ui:Button Icon="{ui:SymbolIcon Play24}"
                                                   Margin="0 0 2 0"
                                                   ToolTip="{utils:Localization page_downloads_resume}"
                                                   Command="{Binding DataContext.ViewModel.ResumeCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Visibility>
                                                <MultiBinding Converter="{StaticResource AndVisibilityConverter}">
                                                    <Binding Path="IsActive"
                                                             Converter="{StaticResource BoolToVisConverter}"
                                                             ConverterParameter="invert" />

                                                    <Binding Path="StatusState"
                                                             Converter="{StaticResource BoolToVisConverter}"
                                                             ConverterParameter="!~Error" />

                                                    <Binding Path="StatusState"
                                                             Converter="{StaticResource BoolToVisConverter}"
                                                             ConverterParameter="!~Retrying" />
                                                </MultiBinding>
                                            </ui:Button.Visibility>
                                        </ui:Button>

                                        <!-- Destructive/non-essential actions stay disabled while merging. -->
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="IsEnabled"
                                                            Value="True" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="Merging">
                                                            <Setter Property="IsEnabled"
                                                                    Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <ui:Button Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                                                       ToolTip="{utils:Localization page_downloads_retry}"
                                                       Margin="0 0 2 0"
                                                       Command="{Binding DataContext.ViewModel.RetryCommand,
                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}"
                                                       IsEnabled="{Binding StatusState, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Error}">
                                                <ui:Button.Visibility>
                                                    <MultiBinding Converter="{StaticResource OrVisibilityConverter}">
                                                        <Binding Path="StatusState"
                                                                 Converter="{StaticResource BoolToVisConverter}"
                                                                 ConverterParameter="Error" />

                                                        <Binding Path="StatusState"
                                                                 Converter="{StaticResource BoolToVisConverter}"
                                                                 ConverterParameter="Retrying" />
                                                    </MultiBinding>
                                                </ui:Button.Visibility>
                                            </ui:Button>

                                            <ui:Button Icon="{ui:SymbolIcon FolderOpen24}"
                                                       ToolTip="{utils:Localization page_downloads_open_folder}"
                                                       Margin="0 0 2 0"
                                                       Command="{Binding DataContext.ViewModel.OpenFolderCommand, 
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}"
                                                       IsEnabled="{Binding StatusState, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Completed}"/>

                                            <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                                       ToolTip="{utils:Localization page_downloads_cancel}"
                                                       Foreground="#AAEF5350"
                                                       Command="{Binding DataContext.ViewModel.CancelCommand,
                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ui:CardExpander.Header>

                        <ui:CardExpander.Content>
                            <StackPanel>
                                <controls:InfoRow LabelText="{utils:Localization download_view_file_name_title}"
                                                  ValueText="{Binding FileName}"
                                                  Margin="0 -10 0 0" />
                                <controls:InfoRow LabelText="{utils:Localization download_view_file_save_path_title}"
                                                  ValueText="{Binding SavePath}" />
                                <controls:InfoRow LabelText="{utils:Localization download_view_file_url_title}"
                                                  ValueText="{Binding Url}" />
                                <controls:InfoRow LabelText="MD5"
                                                  ValueText="{Binding Md5Hash}"
                                                  Visibility="{Binding Md5Hash, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                                <controls:InfoRow LabelText="SHA-1"
                                                  ValueText="{Binding Sha1Hash}"
                                                  Visibility="{Binding Sha1Hash, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                                <controls:InfoRow LabelText="SHA-256"
                                                  ValueText="{Binding Sha256Hash}"
                                                  Visibility="{Binding Sha256Hash, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                                <controls:InfoRow LabelText="{utils:Localization download_view_file_cap_loaded_title}">
                                    <controls:InfoRow.ValueContent>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="11,5">
                                            <ui:TextBlock FontSize="12"
                                                          FontWeight="Medium"
                                                          VerticalAlignment="Center"
                                                          TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding DownloadedFormatted}" />
                                                <Run Text="/" />
                                                <Run Text="{Binding TotalFormatted}" />
                                            </ui:TextBlock>
                                        </StackPanel>
                                    </controls:InfoRow.ValueContent>
                                </controls:InfoRow>
                                <controls:InfoRow LabelText="{utils:Localization download_view_file_status_title}"
                                                  ValueText="{Binding StatusText}" />
                                <controls:InfoRow LabelText="{utils:Localization download_view_file_start_time_title}"
                                                  ValueText="{Binding StartTime}" />
                                <controls:InfoRow LabelText="{utils:Localization download_view_file_end_time_title}"
                                                  ValueText="{Binding EndTime}"
                                                  IsLast="True" />
                            </StackPanel>
                        </ui:CardExpander.Content>
                    </ui:CardExpander>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ── Status bar ──────────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Padding="0,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0"
                           Text="{Binding ViewModel.StatusText}"
                           Opacity="0.5"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <ui:Flyout Grid.Column="1"
                           Margin="0 0 0 7"
                           Padding="6"
                           IsOpen="{Binding ViewModel.IsFlyoutOpen, Mode=TwoWay}"
                           Placement="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Margin="0,0,0,0"
                                   Content="{utils:Localization page_downloads_action_delete_completed_title}"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Appearance="Caution"
                                   Command="{Binding ViewModel.DeleteAllCompletedCommand, Mode=OneWay}" />
                        <ui:Button Margin="4,0,0,0"
                                   Content="{utils:Localization page_downloads_action_delete_all_title}"
                                   Icon="{ui:SymbolIcon DeleteDismiss24}"
                                   Appearance="Danger"
                                   Command="{Binding ViewModel.DeleteAllCommand, Mode=OneWay}" />
                        <ui:Button Margin="4,0,0,0"
                                   Content="{utils:Localization page_downloads_action_pause_all_title}"
                                   Icon="{ui:SymbolIcon Pause24}"
                                   Command="{Binding ViewModel.PauseAllCommand, Mode=OneWay}" />
                        <ui:Button Margin="4,0,0,0"
                                   Content="{utils:Localization page_downloads_action_resume_all_title}"
                                   Icon="{ui:SymbolIcon Play24}"
                                   Appearance="Primary"
                                   Command="{Binding ViewModel.ResumeAllCommand, Mode=OneWay}" />
                        <ui:Button Margin="4,0,0,0"
                                   Content="{utils:Localization page_downloads_action_retry_all_title}"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Appearance="Info"
                                   Command="{Binding ViewModel.RetryAllCommand, Mode=OneWay}" />
                    </StackPanel>
                </ui:Flyout>
                <ui:Button Grid.Column="1"
                           Content="{utils:Localization page_downloads_action_title}"
                           Icon="{ui:SymbolIcon ExpandUpRight20}"
                           Appearance="Caution"
                           Command="{Binding ViewModel.OpenActionFlyoutCommand, Mode=OneWay}"
                           CommandParameter="{Binding RelativeSource={RelativeSource Self}, Mode=OneWay}" />
                <ui:Button Grid.Column="3"
                           Content="{utils:Localization page_downloads_add_title}"
                           Icon="{ui:SymbolIcon AddCircle24}"
                           Appearance="Primary"
                           Command="{Binding ViewModel.AddCommand, Mode=OneWay}" />
                <ui:Button Grid.Column="5"
                           Content="{utils:Localization page_downloads_refresh_title}"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Appearance="Transparent"
                           Command="{Binding ViewModel.RefreshCommand, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
