<Application x:Class="PDownloader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:PDownloader.Helpers"
             DispatcherUnhandledException="OnDispatcherUnhandledException"
             Exit="OnExit"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />

                <ResourceDictionary Source="Controls/ReferralCard.xaml" />
                <ResourceDictionary Source="Controls/GalleryNavigationPresenter.xaml" />
                <ResourceDictionary Source="Controls/FormFieldCard.xaml" />
                <ResourceDictionary Source="Controls/AcrylicPanel.xaml" />
                <ResourceDictionary Source="Controls/InfoRow.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <helpers:BoolToGreenRedBrush x:Key="BoolToGreenRedBrush" />
            <helpers:BoolToStatusText x:Key="BoolToStatusText" />
            <helpers:StringToColorConverter x:Key="StringToColorConverter" />
            <helpers:BooleanToString x:Key="BooleanToString" />
            <helpers:StatusToIconConverter x:Key="StatusToIconConverter" />
            <helpers:StatusToTextConverter x:Key="StatusToTextConverter" />
            <helpers:BoolToVisConverter x:Key="BoolToVisConverter" />
            <helpers:OrVisibilityConverter x:Key="OrVisibilityConverter" />
            <helpers:AndVisibilityConverter x:Key="AndVisibilityConverter" />
            <helpers:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter" />
            <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />

            <ControlTemplate x:Key="StarErrorTemplate">
                <Grid>
                    <AdornedElementPlaceholder x:Name="adornerPlaceholder" />
                    <TextBlock Text="*"
                               Foreground="Red"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,2,10,0"
                               HorizontalAlignment="Right" />
                </Grid>
            </ControlTemplate>

            <Style TargetType="ui:TextBox"
                   BasedOn="{StaticResource DefaultUiTextBoxStyle}">
                <Setter Property="Validation.ErrorTemplate"
                        Value="{StaticResource StarErrorTemplate}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
