<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Select native extension files for the current build architecture. -->
    <ExtPlatformFolder Condition="'$(RuntimeIdentifier)' == 'win-arm64' Or '$(PlatformTarget)' == 'ARM64'">winarm64</ExtPlatformFolder>
    <ExtPlatformFolder Condition="'$(ExtPlatformFolder)' == ''">win64</ExtPlatformFolder>

    <!-- Publish config -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>

    <Authors>Song Mai Software</Authors>
    <RepositoryUrl>https://github.com/maihcx/PDownloader.git</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
	<AssemblyName>PDownloader Core</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Optimize>True</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PDownloader.CFS\PDownloader.CFS.csproj" />
    <ProjectReference Include="..\PDownloader.Contracts\PDownloader.Contracts.csproj" />
    <ProjectReference Include="..\PDownloader.Downloads\PDownloader.Downloads.csproj" />
    <ProjectReference Include="..\PDownloader.Infrastructure\PDownloader.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ExtFiles Include="Ext\$(ExtPlatformFolder)\**\*" />
  </ItemGroup>

  <Target Name="CopyExtFilesAfterBuild" AfterTargets="Build">
    <Copy SourceFiles="@(ExtFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyExtFilesAfterPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(ExtFiles)" DestinationFiles="@(ExtFiles->'$(PublishDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
